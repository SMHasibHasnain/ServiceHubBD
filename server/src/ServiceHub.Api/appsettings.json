{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=servicehub;Username=servicehub"
  },
  "Jwt": {
    "Issuer": "servicehub-bd",
    "Audience": "servicehub-bd-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1,
    "RememberMeRefreshTokenDays": 30
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "SampleZones": false
  },
  "Cors": {
    "Origins": []
  },
  "RateLimits": {
    "AuthPerMinute": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
